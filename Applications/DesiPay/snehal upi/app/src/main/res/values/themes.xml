<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Material 3 theme. NoActionBar because we draw our own MaterialToolbar
        in activity_main.xml and attach it with setSupportActionBar().
    -->
    <style name="Theme.UpiPayments" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/indigo_700</item>
        <item name="colorPrimaryContainer">@color/indigo_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_700</item>
        <item name="colorSecondaryContainer">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
    </style>
</resources>
