<?xml version="1.0" encoding="utf-8"?>
<!--
    Navigation graph with two destinations:
      1. PaymentFragment  (the form, also the start destination)
      2. ResultFragment   (the confirmation screen)

    The action defines the transition from the form to the result screen.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/paymentFragment">

    <fragment
        android:id="@+id/paymentFragment"
        android:name="com.example.upipayments.ui.PaymentFragment"
        android:label="@string/pay_title">

        <action
            android:id="@+id/action_paymentFragment_to_resultFragment"
            app:destination="@id/resultFragment" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.example.upipayments.ui.ResultFragment"
        android:label="@string/result_title" />
</navigation>
