<?xml version="1.0" encoding="utf-8"?>
<!-- Confirmation screen: status icon + title + details + a retry button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- The status icon is tinted at runtime depending on the result. -->
    <ImageView
        android:id="@+id/imageStatus"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="48dp"
        android:importantForAccessibility="no"
        app:tint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/textStatusTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textStatusDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Returns to the payment form so the user can retry. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonPayAgain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/pay_again" />

</LinearLayout>
