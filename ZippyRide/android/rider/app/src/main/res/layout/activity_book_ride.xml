<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="#0F0F1A">

  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Book a Ride"
        android:textColor="#E0E0E0"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

      <TextView
        android:id="@+id/tv_pickup_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pickup: Current location"
        android:textColor="#888"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

      <Button
        android:id="@+id/btn_set_pickup"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Set Pickup on Map"
        android:textColor="#0F0F1A"
        android:backgroundTint="#4FC3F7"
        android:textAllCaps="false"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

      <EditText
        android:id="@+id/et_drop_location"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Where to? Tap on map or type"
        android:background="@drawable/bg_input"
        android:padding="14dp"
        android:textColor="#E0E0E0"
        android:textColorHint="#666"
        android:layout_marginBottom="12dp" />

      <Button
        android:id="@+id/btn_estimate_fare"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="Get Fare Estimate"
        android:textColor="#0F0F1A"
        android:backgroundTint="#4CAF50"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp" />

      <TextView
        android:id="@+id/tv_fare_estimate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap 'Get Fare Estimate' above"
        android:textColor="#4FC3F7"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

      <Button
        android:id="@+id/btn_book_ride"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Book Ride"
        android:textColor="#0F0F1A"
        android:backgroundTint="#4FC3F7"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:enabled="false" />

    </LinearLayout>
  </ScrollView>

  <fragment
    android:id="@+id/map"
    android:name="com.google.android.gms.maps.SupportMapFragment"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />

</LinearLayout>
